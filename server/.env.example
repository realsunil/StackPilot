# Server port
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://realsunil:Sunil0150@cluster0.mptta1m.mongodb.net/?appName=Cluster0

# URL of the deployed/local frontend (for CORS + socket)
CLIENT_URL=http://localhost:3000

# JWT secret - generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=c6ece4a8c3f0e964054bb11e94d1124cc4dee903f0db481da747342e938e6e73def59c136c78c32d85ef49445a9f0078

# Public URL where THIS backend is reachable (used to build the OAuth
# callback URLs below). For local dev this is fine as-is.
SERVER_URL=http://localhost:5000

# --- "Login with Vercel" (free) -----------------------------------------
# Create at: vercel.com -> Account/Team Settings -> Apps -> Create
# Authorization Callback URL: <SERVER_URL>/api/auth/connect/vercel/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# --- "Login with Netlify" (free) ----------------------------------------
# Create at: app.netlify.com -> User settings -> Applications -> New OAuth App
# Redirect URI: <SERVER_URL>/api/auth/connect/netlify/callback
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=

# NOTE: Render has no public OAuth app system, so there's no "Login with
# Render" button possible - users connect it with a free personal API key
# instead (one time, from the Dashboard page), which is still never
# re-requested afterwards.

# NOTE: This app is multi-tenant by design.
# There are NO platform tokens hardcoded here (Vercel/Netlify/Render).
# Every user connects their OWN account from the in-app Dashboard page,
# and every deployment runs on that user's own account - never on
# whoever is hosting this server.
